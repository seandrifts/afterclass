# ---------------------------------------------------------------
# 複製成 .env.local 並填入實際值。.env.local 不會進 git。
# ---------------------------------------------------------------

# 網站網址。QR Code 與 LINE callback 都從這裡產生。
# 部署到 Vercel 時可以留空，會自動用 Vercel 的正式網域。
# 綁自訂網域之後才需要明確填寫。
SITE_URL=http://localhost:3100

# ---------------------------------------------------------------
# Supabase
# 從 https://supabase.com/dashboard 專案的 Settings > API 取得
# ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# service_role key。有完整資料庫權限，只在伺服器端使用，絕不可外洩
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------
# LINE Login
# 在 https://developers.line.biz 建立 Provider > LINE Login Channel
# Callback URL 設為 {SITE_URL}/auth/line/callback
# ---------------------------------------------------------------
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# ---------------------------------------------------------------
# LINE 官方帳號（Messaging API）
# 用來推播點數到期提醒。留空的話推播功能會自動跳過。
#
# Developers Console → 同一個 Provider 底下的 Messaging API channel
#   → Messaging API 分頁 → 最下面 Channel access token (long-lived)
#
# 注意：Messaging API channel 必須跟上面的 Login channel 在
# 同一個 Provider，否則 userId 對不起來，推不到特定客人。
# ---------------------------------------------------------------
LINE_MESSAGING_TOKEN=

# ---------------------------------------------------------------
# Session 簽章金鑰
# 用 openssl rand -base64 32 產生，至少 32 字元
# 換掉會讓所有人被登出
# ---------------------------------------------------------------
SESSION_SECRET=

# ---------------------------------------------------------------
# 排程用的共享密鑰。呼叫 /api/cron/* 時要帶
# Authorization: Bearer {CRON_SECRET}
# ---------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------
# 後台入口的秘密路徑
#
# 後台登入頁的網址是 /enter/{這串}，對不上就回 404。
# 這是縱深防禦的一層，用來擋掉滿街掃描 /admin、/wp-admin
# 這類常見路徑的自動化機器人，不是主要防線。
#
# 用 openssl rand -hex 12 產生。換掉之後舊書籤會失效。
# ---------------------------------------------------------------
ADMIN_ENTRY_KEY=
