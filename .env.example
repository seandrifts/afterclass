# ---------------------------------------------------------------
# 複製成 .env.local 並填入實際值。.env.local 不會進 git。
# ---------------------------------------------------------------

# 網站網址。QR Code 會指向這裡，越短越好掃
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------
# Supabase
# 從 https://supabase.com/dashboard 專案的 Settings > API 取得
# ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# service_role key。有完整資料庫權限，只在伺服器端使用，絕不可外洩
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------
# LINE Login
# 在 https://developers.line.biz 建立 Provider > LINE Login Channel
# Callback URL 設為 {NEXT_PUBLIC_SITE_URL}/auth/line/callback
# ---------------------------------------------------------------
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# ---------------------------------------------------------------
# Session 簽章金鑰
# 用 openssl rand -base64 32 產生，至少 32 字元
# 換掉會讓所有人被登出
# ---------------------------------------------------------------
SESSION_SECRET=

# ---------------------------------------------------------------
# 排程用的共享密鑰。呼叫 /api/cron/* 時要帶
# Authorization: Bearer {CRON_SECRET}
# ---------------------------------------------------------------
CRON_SECRET=
